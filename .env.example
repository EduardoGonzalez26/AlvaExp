# Alva environment variables. Copy to .env.local for local work.
# This file must never contain real secrets.

# Public site origin used for metadata, canonical URLs, hreflang and the sitemap.
# Leave empty to use the built-in fallback (https://alvaexpansion.com).
# Format: origin only, no trailing slash, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# Feature flag for the Edgar Hintze profile (pending his written approval).
# "true" shows both profile cards; anything else shows only Emilio Rivas Garin.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing it.
NEXT_PUBLIC_SHOW_EDGAR_PROFILE=false

# Cloudflare Turnstile (reserved for Phase 2, the contact form).
# Phase 1 only documents these variables; nothing reads them yet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email delivery (reserved for a later phase, not used in Phase 1).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
