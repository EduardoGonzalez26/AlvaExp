# Alva environment variables. Copy to .env.local for local work.
# This file must never contain real secrets.

# ---------------------------------------------------------------------------
# Indexing gate (server-side, staging/launch)
# ---------------------------------------------------------------------------
# Staging must stay non-indexable until the domain is purchased and the launch
# checklist is approved. Only the exact value "true" enables indexing. Any
# other value (including missing) keeps the whole site `noindex, nofollow`,
# serves `Disallow: /` from robots.txt, omits the sitemap reference and adds
# an `X-Robots-Tag: noindex, nofollow` header to every response.
#
# This is NOT a NEXT_PUBLIC_* variable: it stays server-side. It is evaluated
# at build time (metadata, robots.txt and the sitemap are generated during
# `next build`) and must also be present at runtime for dynamic routes (404)
# and response headers. Changing it requires a rebuild and redeploy.
# Keep false until docs/launch-checklist.md is complete.
SITE_INDEXABLE=false

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------
# Used for canonical URLs, hreflang, Open Graph, the sitemap and the contact
# API Origin/Referer check.
# - Staging: the exact deployment origin, e.g.
#     https://alva-expansion-git-staging-<team>.vercel.app
# - Production: https://alvaexpansion.com (after the domain is purchased)
# Leave empty only to use the built-in fallback (https://alvaexpansion.com).
# Format: origin only, no trailing slash and no path.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time:
# changing this variable requires a rebuild.
NEXT_PUBLIC_SITE_URL=

# Feature flag for the Edgar Hintze profile (pending his written approval).
# "true" shows both profile cards; anything else shows only Emilio Rivas Garin.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing it.
NEXT_PUBLIC_SHOW_EDGAR_PROFILE=false

# ---------------------------------------------------------------------------
# Contact form: email delivery (POST /api/contact)
# ---------------------------------------------------------------------------
# Mode:
#   console = development only. Logs requestId, inquiry type, locale and field
#             lengths. It never logs values and never sends email.
#   resend  = real delivery through Resend. Required in production, where
#             console mode is rejected with 503 SERVICE_UNAVAILABLE.
# Default when unset: console in development/test, resend in production.
#
# Do not switch production to resend until the Privacy Notice is published and
# the inbox and sender are real (see docs/launch-checklist.md).
CONTACT_EMAIL_MODE=console

# Required when CONTACT_EMAIL_MODE=resend (and therefore in production).
# Server-side secrets: never prefix secrets with NEXT_PUBLIC_.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Recipient inbox for form notifications:
# CONTACT_TO_EMAIL=hello@example.com
# Verified Resend sender. A display name is allowed:
# CONTACT_FROM_EMAIL=Alva <no-reply@example.com>

# ---------------------------------------------------------------------------
# Contact form: Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Production requires both real values. If either is missing, or if either
# matches one of Cloudflare's documented test keys below, POST /api/contact
# returns 503 SERVICE_UNAVAILABLE and logs a configuration issue; it never
# simulates success. The test secret always validates, so production rejects
# both test keys instead of silently disabling anti-bot protection.
#
# Development: leave both empty to use Cloudflare's documented test keys.
#   Site key that always passes:   1x00000000000000000000AA
#   Secret key that always passes: 1x0000000000000000000000000000000AA
# The form falls back to the test site key only when NODE_ENV is not
# production. Production without a site key shows a controlled error and
# refuses to submit. Test keys are only valid in development.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public and inlined at build time (rebuild
# after changing it). TURNSTILE_SECRET_KEY is server-side and must stay secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# POST /api/contact contract (kept next to the variables it depends on)
# ---------------------------------------------------------------------------
# Request:  Content-Type: application/json, maximum 32 KB.
# Success:  200 {"ok":true}
# Error:    4xx/5xx {"ok":false,"code":"...","fieldErrors"?:{...}}
# Codes:    INVALID_INPUT 400, UNSUPPORTED_MEDIA_TYPE 415,
#           PAYLOAD_TOO_LARGE 413, METHOD_NOT_ALLOWED 405,
#           FORBIDDEN_ORIGIN 403, TURNSTILE_FAILED 403, RATE_LIMITED 429,
#           DELIVERY_FAILED 502, SERVICE_UNAVAILABLE 503.
# Rate limit (in-memory, best-effort): 5 submissions/10 minutes and 20/hour
# per client IP. Production should also enforce rate limiting at Cloudflare/WAF.
